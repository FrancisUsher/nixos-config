{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "perl \"$HOME/.claude/hooks/detect-new-comments.pl\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 400000,
  "attribution": {
    "commit": ""
  },
  "theme": "dark",
  "prefersReducedMotion": true,
  "feedbackSurveyRate": 0,
  "spinnerTipsEnabled": false,
  "preferredNotifChannel": "notifications_disabled",
  "voiceEnabled": false,
  "voice": {
    "enabled": false,
    "mode": "hold"
  }
}
