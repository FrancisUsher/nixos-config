# "Ancient Ruins" palette, ported from arch-reference/themer/palette.toml
# into a base16 scheme for Stylix.
{
  slug = "ancient-ruins";
  scheme = "Ancient Ruins";
  author = "Francis Usher";

  base00 = "1c1b1a"; # background
  base01 = "262423"; # surface (lighter bg: status bars, line highlight)
  base02 = "4a4733"; # highlight (selection bg)
  base03 = "7a7875"; # comment (comments, invisibles)
  base04 = "7a7875"; # comment, reused (dark fg)
  base05 = "b8b5b1"; # text (default fg)
  base06 = "e3cba5"; # accentDetail (light fg)
  base07 = "e3cba5"; # accentDetail, reused (light bg)
  base08 = "8c504a"; # redFade (red: errors)
  base09 = "9d5d40"; # terracotta (orange: integers)
  base0A = "d4af37"; # paleGold (yellow: classes)
  base0B = "76856a"; # moss (green: strings)
  base0C = "6ab0c7"; # skyBlue (cyan: support, escape chars)
  base0D = "c4824d"; # amber (blue slot, by role not hue: this palette's own
                      # source comment ties amber to "functional things (like
                      # function names)" - base0D is functions/methods)
  base0E = "846b97"; # purpleFade (purple: keywords)
  base0F = "c2b280"; # sand (brown: deprecated)
}
